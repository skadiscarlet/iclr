        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
