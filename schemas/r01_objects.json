      },
      "blocker": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Blocker"
      },
      "local_catalog_key": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Local Catalog Key"
      }
    },
    "required": [
      "pair_id",
      "project_family",
      "dataset_origin",
      "dataset_revision",
      "source_locator",
      "buggy_revision",
      "fixed_revision",
      "category_claim",
      "obligation_basis",
      "status",
      "license_note",
      "split"
    ],
    "title": "CandidatePair",
    "type": "object"
  },
  "SmokeConfig": {
    "additionalProperties": false,
    "properties": {
      "mode": {
        "const": "fixture_replay",
        "title": "Mode",
        "type": "string"
      },
      "seed": {
        "title": "Seed",
        "type": "integer"
      },
      "representations": {
        "items": {
          "enum": [
            "history",
            "sbs"
          ],
          "type": "string"
        },
        "title": "Representations",
        "type": "array"
      },
      "evidence_order": {
        "const": "frozen",
        "title": "Evidence Order",
        "type": "string"
      },
      "max_observations": {
        "title": "Max Observations",
        "type": "integer"
      },
      "split": {
        "const": "dev_pilot",
        "title": "Split",
        "type": "string"
      },
      "model_calls_allowed": {
        "const": 0,
        "title": "Model Calls Allowed",
        "type": "integer"
      },
      "compute_detection_metrics": {
        "const": false,
        "title": "Compute Detection Metrics",
        "type": "boolean"
      },
      "fixtures_root": {
        "default": "fixtures/r01",
        "title": "Fixtures Root",
        "type": "string"
      },
      "value_scorer_available": {
        "const": false,
        "default": false,
        "title": "Value Scorer Available",
        "type": "boolean"
      }
    },
    "required": [
      "mode",
      "seed",
      "representations",
      "evidence_order",
      "max_observations",
      "split",
      "model_calls_allowed",
      "compute_detection_metrics"
    ],
    "title": "SmokeConfig",
    "type": "object"
  },
  "RunManifest": {
    "additionalProperties": false,
    "properties": {
      "schema_version": {
        "const": "1.0",
        "default": "1.0",
        "title": "Schema Version",
        "type": "string"
      },
      "mode": {
        "const": "fixture_replay",
        "title": "Mode",
        "type": "string"
      },
      "seed": {
        "title": "Seed",
        "type": "integer"
      },
      "split": {
        "const": "dev_pilot",
        "title": "Split",
        "type": "string"
      },
      "representations": {
        "items": {
          "enum": [
            "history",
            "sbs"
          ],
          "type": "string"
        },
        "title": "Representations",
        "type": "array"
      },
      "evidence_order": {
        "const": "frozen",
        "title": "Evidence Order",
        "type": "string"
      },
      "max_observations": {
        "title": "Max Observations",
        "type": "integer"
      },
      "model_calls": {
        "title": "Model Calls",
        "type": "integer"
      },
      "model_calls_allowed": {
        "title": "Model Calls Allowed",
        "type": "integer"
      },
      "compute_detection_metrics": {
        "title": "Compute Detection Metrics",
        "type": "boolean"
      },
      "detection_metrics": {
        "default": null,
        "title": "Detection Metrics",
        "type": "null"
      },
      "detection_metrics_status": {
        "const": "not_evaluated",
        "default": "not_evaluated",
        "title": "Detection Metrics Status",
        "type": "string"
      },
      "training_loss": {
        "default": null,
        "title": "Training Loss",
        "type": "null"
      },
      "q_accuracy": {
        "default": null,
        "title": "Q Accuracy",
        "type": "null"
      },
      "value_scorer_available": {
        "const": false,
        "default": false,
        "title": "Value Scorer Available",
        "type": "boolean"
      },
      "code_sha": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Code Sha"
      },
      "config_sha256": {
        "title": "Config Sha256",
        "type": "string"
      },
      "material_sha256": {
        "title": "Material Sha256",
        "type": "string"
      },
      "output_index": {
        "additionalProperties": {
          "type": "string"
        },
        "title": "Output Index",
        "type": "object"
      },
      "exit_status": {
        "title": "Exit Status",
        "type": "string"
      },
      "started_at": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Started At"
      },
      "finished_at": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Finished At"
      }
    },
    "required": [
      "mode",
      "seed",
      "split",
      "representations",
      "evidence_order",
      "max_observations",
      "model_calls",
      "model_calls_allowed",
      "compute_detection_metrics",
      "config_sha256",
      "material_sha256",
      "output_index",
      "exit_status"
    ],
    "title": "RunManifest",
    "type": "object"
  }
}
